# Copy to .env in this folder and fill in only what you use.
# Real environment variables override this file.
# Nothing here is ever written into an order folder, a log, or a delivery.

# --- voice cloning + TTS -----------------------------------------------------
ELEVENLABS_API_KEY=
# Endpoints and model IDs drift. Change them here, not in the code.
# VOXSWAP_ELEVEN_BASE=https://api.elevenlabs.io/v1
# VOXSWAP_ELEVEN_TTS_MODEL=eleven_multilingual_v2
# VOXSWAP_ELEVEN_STT_MODEL=scribe_v1
# Keep this a pcm_* value unless you have ffmpeg installed.
# VOXSWAP_ELEVEN_OUTPUT_FORMAT=pcm_24000

# --- translation, hosted (needs: pip install anthropic) ----------------------
ANTHROPIC_API_KEY=
# VOXSWAP_CLAUDE_MODEL=claude-opus-5
# VOXSWAP_CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max

# --- translation, local: any OpenAI-compatible server ------------------------
# llama.cpp:  llama-server -m model.gguf -c 8192 --port 8080
# Ollama:     http://127.0.0.1:11434/v1  (and set a real model name)
# VOXSWAP_LOCAL_LLM_BASE=http://127.0.0.1:8080/v1
# VOXSWAP_LOCAL_LLM_MODEL=local-model
# VOXSWAP_LOCAL_LLM_BATCH=12          # small models lose count on longer lists
# VOXSWAP_LOCAL_LLM_TIMEOUT=600
# VOXSWAP_LOCAL_LLM_MAX_TOKENS=4096
# VOXSWAP_LOCAL_LLM_KEY=              # only if your server demands a bearer token

# --- transcription -----------------------------------------------------------
# Point the base at a local whisper.cpp server and no key is needed:
#   whisper-server -m models/ggml-large-v3-turbo.bin --port 8080
#   VOXSWAP_OPENAI_BASE=http://127.0.0.1:8080/v1
OPENAI_API_KEY=
# VOXSWAP_OPENAI_BASE=https://api.openai.com/v1
# VOXSWAP_OPENAI_ASR_MODEL=whisper-1

# --- self-hosted voice (see docs/11-RUNNING-LOCAL.md) ------------------------
# STRONGLY PREFERRED: a resident server, so the model loads once and not once
# per line.   python3 tools/local/tts_server.py --engine xtts
# VOXSWAP_LOCAL_TTS_URL=http://127.0.0.1:8123/tts
#
# Or a command per line — simpler, but reloads the model every utterance.
# Must read {text_file}, clone {speaker_wav}, and write a WAV to {output}.
# VOXSWAP_LOCAL_TTS_CMD=python3 my_tts.py --text {text_file} --speaker {speaker_wav} --lang {language} --out {output}
#
# Local ASR through the bundled whisper.cpp wrapper (or use the server above).
# VOXSWAP_WHISPER_BIN=/path/to/whisper.cpp/build/bin/whisper-cli
# VOXSWAP_WHISPER_MODEL=/path/to/whisper.cpp/models/ggml-large-v3-turbo.bin
# VOXSWAP_LOCAL_ASR_CMD=python3 tools/local/whisper_cpp.py --in {input} --out {output} --lang {language}
#
# VOXSWAP_LOCAL_VOICE_DIR=.voices
# VOXSWAP_LOCAL_TIMEOUT=900

# --- paths and behaviour -----------------------------------------------------
# VOXSWAP_ORDERS_DIR=orders
# VOXSWAP_WORK_DIR=work
# VOXSWAP_DELIVERY_DIR=delivery
# VOXSWAP_ARCHIVE_DIR=archive
# VOXSWAP_WATCH_INTERVAL=10
# VOXSWAP_LOG_LEVEL=info              # debug | info | warn | error
# VOXSWAP_FFMPEG=ffmpeg
# VOXSWAP_FFPROBE=ffprobe
