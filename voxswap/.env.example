# Copy to .env in this folder and fill in only what you use.
# Real environment variables override this file.
# Nothing here is ever written into an order folder, a log, or a delivery.

# --- voice cloning + TTS -----------------------------------------------------
ELEVENLABS_API_KEY=
# Endpoints and model IDs drift. Change them here, not in the code.
# VOXSWAP_ELEVEN_BASE=https://api.elevenlabs.io/v1
# VOXSWAP_ELEVEN_TTS_MODEL=eleven_multilingual_v2
# VOXSWAP_ELEVEN_STT_MODEL=scribe_v1
# Keep this a pcm_* value unless you have ffmpeg installed.
# VOXSWAP_ELEVEN_OUTPUT_FORMAT=pcm_24000

# --- translation (needs: pip install anthropic) ------------------------------
ANTHROPIC_API_KEY=
# VOXSWAP_CLAUDE_MODEL=claude-opus-5
# VOXSWAP_CLAUDE_EFFORT=medium        # low | medium | high | xhigh | max

# --- transcription -----------------------------------------------------------
OPENAI_API_KEY=
# VOXSWAP_OPENAI_BASE=https://api.openai.com/v1
# VOXSWAP_OPENAI_ASR_MODEL=whisper-1

# --- self-hosted models ------------------------------------------------------
# Must read {text_file}, clone {speaker_wav}, and write a WAV to {output}.
# VOXSWAP_LOCAL_TTS_CMD=python tools/xtts_say.py --text {text_file} --speaker {speaker_wav} --lang {language} --out {output}
# Must read {input} and write JSON {"text","language","segments"} to {output}.
# VOXSWAP_LOCAL_ASR_CMD=python tools/whisper_cpp.py --in {input} --out {output} --lang {language}
# VOXSWAP_LOCAL_VOICE_DIR=.voices
# VOXSWAP_LOCAL_TIMEOUT=900

# --- paths and behaviour -----------------------------------------------------
# VOXSWAP_ORDERS_DIR=orders
# VOXSWAP_WORK_DIR=work
# VOXSWAP_DELIVERY_DIR=delivery
# VOXSWAP_ARCHIVE_DIR=archive
# VOXSWAP_WATCH_INTERVAL=10
# VOXSWAP_LOG_LEVEL=info              # debug | info | warn | error
# VOXSWAP_FFMPEG=ffmpeg
# VOXSWAP_FFPROBE=ffprobe
