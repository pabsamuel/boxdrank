{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perde",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // The Vite build of apps/web is served as static assets; /api/* always hits the Worker.
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // "open": everything unlocked (dev, self-hosting). "lemonsqueezy": Plus needs a licence key.
    "ENTITLEMENTS_MODE": "open",
    "LEMONSQUEEZY_STORE_ID": "",
    "LEMONSQUEEZY_PRODUCT_ID": "",
    // Lemon Squeezy checkout link; empty until the store exists (docs/PRICING.md).
    "PERDE_CHECKOUT_URL": "",
  },
  "observability": { "enabled": true },
}
