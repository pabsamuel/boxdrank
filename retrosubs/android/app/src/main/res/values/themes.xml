<resources>
    <style name="Theme.RetroSubs" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/rs_bg</item>
        <item name="android:statusBarColor">@color/rs_bg</item>
        <item name="android:navigationBarColor">@color/rs_bg</item>
        <item name="colorPrimary">@color/rs_accent</item>
        <item name="colorOnPrimary">@color/rs_bg</item>
        <item name="colorSecondary">@color/rs_secondary</item>
    </style>

    <style name="RsLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/rs_ink</item>
    </style>
</resources>
