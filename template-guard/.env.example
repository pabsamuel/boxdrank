# monday app OAuth credentials (monday developer console -> your app -> OAuth)
MONDAY_CLIENT_ID=
MONDAY_CLIENT_SECRET=
MONDAY_SIGNING_SECRET=
MONDAY_REDIRECT_URI=http://localhost:8302/auth/callback

# Which platform this runs on: 'monday-code' or 'self-hosted' (default).
# STATED, never auto-detected — guessing wrong would quietly fall back to a
# SQLite file on an ephemeral container and lose every install token on the
# next deploy while looking healthy. See ADR-020.
# On monday code, everything below comes from `mapps code:env` /
# `mapps code:secret` instead of this file.
TEMPLATE_GUARD_PLATFORM=self-hosted

# Where the server listens
PORT=8302

# Where the built client lives. Defaults to dist/client, which is what
# `npm run build` produces and what the Dockerfile copies. In local
# development Vite serves the client on :8301 instead, so the API server
# having nothing to serve there is expected.
# CLIENT_DIR=

# Shared secret the monday code scheduler must send as X-Template-Guard-Cron
# when it calls POST /mndy-cronjob/drift. Unset means the route is unguarded —
# fine locally, not in production.
DRIFT_CRON_SECRET=

# SQLite file holding installs, template snapshots and plans.
# ':memory:' or empty falls back to in-memory storage, which loses every
# install token on restart — the server warns loudly if you do that.
DATABASE_FILE=./data/template-guard.db

# --- Drift monitoring (Pro feature) ---
# Starts the sweep loop in-process. Off by default: a scheduler that runs
# where nobody expects it is a surprise API bill.
DRIFT_SCHEDULER_ENABLED=false
# How often a sweep starts. Default 6 hours.
DRIFT_INTERVAL_MS=21600000

# Opaque key used to encrypt stored access tokens at rest.
# 32 bytes, base64. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# --- Feature flags ---
# One-click repair: adds `boards:write` to the OAuth consent screen and
# enables the three mutations. OFF in v1 (ADR-025) so that "Template Guard
# never writes to your boards" is a true listing claim and the first security
# review contains no writes at all. The manual repair checklist is unaffected.
FEATURE_ONE_CLICK_REPAIR=false

# Reads board automations via `board_automations`, which lives on monday's
# dev (preview) GraphQL schema. That schema is "subject to change" and cannot
# be version-pinned. Default OFF. See docs/00-api-findings.md and ADR-002.
# No paid tier may depend on this flag.
FEATURE_AUTOMATIONS_PREVIEW=false

# --- Production hardening ---
# Redirects plain HTTP to HTTPS and sends HSTS. Requires the proxy in front to
# set X-Forwarded-Proto. Leave false for local http development.
ENFORCE_HTTPS=false

# --- Marketplace billing ---
# monday plan ids that grant Pro, comma-separated, from the developer console.
# LEAVE EMPTY and any subscription event grants Pro — correct only until
# pricing is configured there.
MONDAY_PAID_PLAN_IDS=

# --- Live verification (scripts/verify-live.ts) ---
# A personal API token, used only by the verification script. Never needed by
# the server, which uses per-account OAuth tokens.
MONDAY_API_TOKEN=
